"""Extract the first date near the top of page 1 of each PDF into a two-column Excel file.

Install dependencies: python -m pip install pymupdf openpyxl
Edit PDF_FOLDER and OUTPUT_XLSX below, then run: python extract_activity_dates.py
"""

from datetime import datetime
from pathlib import Path
import re

import fitz  # PyMuPDF
from openpyxl import Workbook
from openpyxl.styles import Alignment, Font, PatternFill


# ============================================================
# CONFIGURATION — CHANGE THESE TWO PATHS
# ============================================================
PDF_FOLDER = r"C:\Temp\SharePointDownloads"
OUTPUT_XLSX = r"C:\Temp\SharePointDownloads\Activity_Dates.xlsx"

# Search the top 45% of page 1. Set to 0.60 if dates appear lower.
TOP_PORTION = 0.45
# ============================================================

MONTH = (
    r"(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|"
    r"Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|"
    r"Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
)

DATE_PATTERN = re.compile(
    rf"""
    (?<!\w)
    (?:
        \d{{4}}[./-]\d{{1,2}}[./-]\d{{1,2}}       # 2026-11-12
        | \d{{1,2}}[./-]\d{{1,2}}[./-]\d{{2,4}}  # 11/12/2026
        | {MONTH}\. ?\s+\d{{1,2}}(?:st|nd|rd|th)?,?\s+\d{{4}}
        | \d{{1,2}}(?:st|nd|rd|th)?\s+{MONTH}\.?,?\s+\d{{4}}
    )
    (?!\w)
    """.replace(r"\. ?", r"\.?"),
    re.IGNORECASE | re.VERBOSE,
)


def parse_date(value: str):
    """Return a datetime value, or None if the detected text is invalid."""
    value = value.strip()
    if re.fullmatch(r"\d{4}[./-]\d{1,2}[./-]\d{1,2}", value):
        year, month, day = re.split(r"[./-]", value)
        try:
            return datetime(int(year), int(month), int(day))
        except ValueError:
            return None

    if re.fullmatch(r"\d{1,2}[./-]\d{1,2}[./-]\d{2,4}", value):
        month, day, year = re.split(r"[./-]", value)
        fmt = "%m/%d/%Y" if len(year) == 4 else "%m/%d/%y"
        try:
            return datetime.strptime(f"{month}/{day}/{year}", fmt)
        except ValueError:
            return None

    value = re.sub(r"(?<=\d)(st|nd|rd|th)\b", "", value, flags=re.I)
    value = re.sub(r"\bSept\b", "Sep", value, flags=re.I)
    value = re.sub(r"[.,]", " ", value)
    value = " ".join(value.split())

    for fmt in ("%B %d %Y", "%b %d %Y", "%d %B %Y", "%d %b %Y"):
        try:
            return datetime.strptime(value, fmt)
        except ValueError:
            continue
    return None


def get_top_date(pdf_path: Path):
    """Find the first valid date by visible top-to-bottom order on page 1."""
    with fitz.open(str(pdf_path)) as document:
        if not document.page_count:
            return None
        page = document[0]
        clip = fitz.Rect(
            page.rect.x0,
            page.rect.y0,
            page.rect.x1,
            page.rect.y0 + page.rect.height * TOP_PORTION,
        )
        data = page.get_text("dict", clip=clip)

    lines = []
    for block in data.get("blocks", []):
        if "lines" not in block:
            continue
        for line in block["lines"]:
            text = "".join(span["text"] for span in line.get("spans", []))
            lines.append((line["bbox"][1], line["bbox"][0], text))

    # Sort by page coordinates, so we use the TOP date, not an arbitrary date.
    for _, _, line_text in sorted(lines):
        for match in DATE_PATTERN.finditer(line_text):
            parsed = parse_date(match.group(0))
            if parsed is not None:
                return parsed
    return None


def main():
    folder = Path(PDF_FOLDER)
    output = Path(OUTPUT_XLSX)
    if not folder.is_dir():
        raise SystemExit(f"PDF folder does not exist: {folder}")

    pdf_files = sorted(
        (p for p in folder.rglob("*") if p.is_file() and p.suffix.lower() == ".pdf"),
        key=lambda p: (p.name.casefold(), str(p).casefold()),
    )
    if not pdf_files:
        raise SystemExit(f"No PDFs found in: {folder}")

    wb = Workbook()
    ws = wb.active
    ws.title = "Activity Dates"
    ws.append(["File Name", "Activity Date"])

    found = 0
    missing = 0
    errors = 0

    for pdf_file in pdf_files:
        try:
            date = get_top_date(pdf_file)
            if date is None:
                missing += 1
                print(f"[NO DATE] {pdf_file.name}")
            else:
                found += 1
                print(f"[FOUND]   {pdf_file.name}: {date:%m/%d/%Y}")
        except Exception as exc:
            date = None
            errors += 1
            print(f"[ERROR]   {pdf_file.name}: {exc}")

        ws.append([pdf_file.name, date])
        ws.cell(ws.max_row, 2).number_format = "mm/dd/yyyy"

    header_fill = PatternFill("solid", fgColor="17365D")
    for cell in ws[1]:
        cell.fill = header_fill
        cell.font = Font(bold=True, color="FFFFFF")
        cell.alignment = Alignment(horizontal="left")

    ws.column_dimensions["A"].width = 56
    ws.column_dimensions["B"].width = 20
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions

    output.parent.mkdir(parents=True, exist_ok=True)
    wb.save(output)

    print("\nFinished!")
    print(f"PDFs processed: {len(pdf_files)}")
    print(f"Dates found:    {found}")
    print(f"No date found:  {missing}")
    print(f"Read errors:    {errors}")
    print(f"Excel saved to: {output}")


if __name__ == "__main__":
    main()
