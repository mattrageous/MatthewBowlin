# ============================================================
# CONFIGURATION - EDIT THESE TWO PATHS
# ============================================================
SOURCE_ROOT = r"C:\Users\YourUsername\OneDrive - Organization\SharePoint Agency Files"
OUTPUT_ROOT = r"C:\Temp\AgencyCombinedPDFs_ByFolder"

# Search the upper 45% of the first page of source PDFs for the activity date.
TOP_PORTION = 0.45
# ============================================================

EXCEL_SUFFIXES = {".xlsx", ".xls", ".xlsm", ".xlsb", ".xltx", ".xltm"}
MANIFEST_FILE = "_generated_pdf_manifest.json"
MONTH = (
    r"(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|"
    r"Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|"
    r"Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
)
DATE_PATTERN = re.compile(
    rf"(?<!\w)(?:"
    rf"\d{{4}}[./-]\d{{1,2}}[./-]\d{{1,2}}|"
    rf"\d{{1,2}}[./-]\d{{1,2}}[./-]\d{{2,4}}|"
    rf"{MONTH}\.?\s+\d{{1,2}}(?:st|nd|rd|th)?,?\s+\d{{4}}|"
    rf"\d{{1,2}}(?:st|nd|rd|th)?\s+{MONTH}\.?,?\s+\d{{4}}"
    rf")(?!\w)", re.I
)


def parse_date(value: str) -> datetime | None:
    value = value.strip()
    if re.fullmatch(r"\d{4}[./-]\d{1,2}[./-]\d{1,2}", value):
        y, m, d = re.split(r"[./-]", value)
        try:
            return datetime(int(y), int(m), int(d))
        except ValueError:
            return None
    if re.fullmatch(r"\d{1,2}[./-]\d{1,2}[./-]\d{2,4}", value):
        m, d, y = re.split(r"[./-]", value)
        try:
            return datetime.strptime(
                f"{m}/{d}/{y}", "%m/%d/%Y" if len(y) == 4 else "%m/%d/%y"
            )
        except ValueError:
            return None
    value = re.sub(r"(?<=\d)(st|nd|rd|th)\b", "", value, flags=re.I)
    value = re.sub(r"\bSept\b", "Sep", value, flags=re.I)
    value = " ".join(re.sub(r"[.,]", " ", value).split())
    for fmt in ("%B %d %Y", "%b %d %Y", "%d %B %Y", "%d %b %Y"):
        try:
            return datetime.strptime(value, fmt)
        except ValueError:
            pass
    return None


def pdf_top_date(page) -> datetime | None:
    """Read visually top-to-bottom within the top portion of page 1."""
    clip = fitz.Rect(page.rect.x0, page.rect.y0, page.rect.x1,
                     page.rect.y0 + page.rect.height * TOP_PORTION)
    data = page.get_text("dict", clip=clip)
    lines = []
    for block in data.get("blocks", []):
        for line in block.get("lines", []):
            content = "".join(span.get("text", "") for span in line.get("spans", []))
            lines.append((line["bbox"][1], line["bbox"][0], content))
    for _, _, text in sorted(lines):
        for match in DATE_PATTERN.finditer(text):
            parsed = parse_date(match.group(0))
            if parsed:
                return parsed
    return None


def message_date(value: str) -> datetime | None:
    value = (value or "").strip()
    if not value:
        return None
    try:
        dt = parsedate_to_datetime(value)
        return datetime(dt.year, dt.month, dt.day)
    except (ValueError, TypeError, OverflowError, IndexError):
        pass
    try:
        dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
        return datetime(dt.year, dt.month, dt.day)
    except ValueError:
        pass
    for match in DATE_PATTERN.finditer(value):
        parsed = parse_date(match.group(0))
        if parsed:
            return parsed
    return None


def as_text(value) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


class _HTMLText(HTMLParser):
    def __init__(self):
        super().__init__()
        self.parts = []

    def handle_data(self, data):
        self.parts.append(data)

    def handle_starttag(self, tag, attrs):
        if tag in {"br", "p", "div", "li", "tr"}:
            self.parts.append("\n")


def read_message(path: Path) -> dict[str, str]:
    msg = extract_msg.Message(str(path))
    try:
        result = {
            "subject": as_text(msg.subject),
            "sender": as_text(msg.sender),
            "to": as_text(msg.to),
            "date": as_text(msg.date),
            "body": as_text(msg.body),
        }
        if not result["body"].strip() and getattr(msg, "htmlBody", None):
            parser = _HTMLText()
            parser.feed(as_text(msg.htmlBody))
            result["body"] = "".join(parser.parts)
        return result
    finally:
        msg.close()


def select_font() -> str:
    for path in (
        Path(r"C:\Windows\Fonts\arial.ttf"),
        Path(r"C:\Windows\Fonts\segoeui.ttf"),
        Path("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"),
    ):
        if path.is_file():
            pdfmetrics.registerFont(TTFont("AgencyMsgFont", str(path)))
            return "AgencyMsgFont"
    return "Helvetica"


def msg_to_pdf_bytes(message: dict[str, str], path: Path, font: str) -> bytes:
    buffer = BytesIO()
    doc = SimpleDocTemplate(buffer, pagesize=letter, leftMargin=42,
                            rightMargin=42, topMargin=44, bottomMargin=44,
                            title=path.name)
    heading = ParagraphStyle("Heading", fontName=font, fontSize=12, leading=16,
                             textColor=colors.HexColor("#17365D"), spaceAfter=9)
    hdr = ParagraphStyle("Header", fontName=font, fontSize=9, leading=13,
                         spaceAfter=4, splitLongWords=True)
    text_style = ParagraphStyle("Body", fontName=font, fontSize=9, leading=13,
                                alignment=TA_LEFT, splitLongWords=True)
    story = [Paragraph("Outlook email: " + escape(path.name), heading)]
    for label, key in (("Subject", "subject"), ("From", "sender"),
                       ("To", "to"), ("Date", "date")):
        story.append(Paragraph(
            f"<b>{label}:</b> {escape(message.get(key, '').strip() or '(not provided)')}", hdr
        ))
    story += [Spacer(1, 8), HRFlowable(width="100%", thickness=0.5,
                                      color=colors.grey), Spacer(1, 9)]
    for line in (message.get("body", "") or "(No readable email body)").splitlines():
        if not line.strip():
            story.append(Spacer(1, 6))
        else:
            story.append(Paragraph(escape(line).replace("\t", "&nbsp; "), text_style))
    doc.build(story)
    return buffer.getvalue()


def group_name(path: Path, source: Path) -> str:
    """Immediate child folder of the SharePoint root, even for nested documents."""
    parts = path.relative_to(source).parts
    return parts[0] if len(parts) > 1 else "(root)"


def safe_basename(name: str) -> str:
    if name == "(root)":
        return "Root"
    cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", name).strip(" .")
    return cleaned or "Folder"


def preferred_output_name(group: str, pdfs: list[Path]) -> str:
    # Keep the original PDF name wherever that is unambiguous.
    if len(pdfs) == 1:
        return pdfs[0].name
    return safe_basename(group) + ".pdf"


def allocate_names(groups: dict[str, dict[str, list[Path]]]) -> dict[str, str]:
    preferred = {group: preferred_output_name(group, data["pdf"])
                 for group, data in groups.items()}
    counts = Counter(name.casefold() for name in preferred.values())
    reserved = set()
    assigned = {}
    # Unique preferred originals get priority so collision-resolvers can't take them.
    for group in sorted(groups, key=lambda g: (counts[preferred[g].casefold()] > 1, g.casefold())):
        original = Path(preferred[group])
        candidate = original.name
        if candidate.casefold() in reserved or counts[candidate.casefold()] > 1:
            candidate = f"{original.stem}_{safe_basename(group)}.pdf"
        counter = 2
        base = Path(candidate).stem
        while candidate.casefold() in reserved:
            candidate = f"{base}_{counter}.pdf"
            counter += 1
        assigned[group] = candidate
        reserved.add(candidate.casefold())
    return assigned


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for piece in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(piece)
    return digest.hexdigest()


def load_manifest(path: Path) -> dict[str, dict[str, str]]:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        groups = data.get("groups", {})
        return {key: value for key, value in groups.items()
                if isinstance(key, str) and isinstance(value, dict)
                and isinstance(value.get("filename"), str)
                and isinstance(value.get("sha256"), str)}
    except (OSError, ValueError, TypeError, AttributeError):
        raise RuntimeError(f"Cannot read the output ownership manifest: {path}")


def safe_to_replace(target: Path, prior: dict[str, dict[str, str]]) -> None:
    if not target.exists():
        return
    if not target.is_file():
        raise RuntimeError(f"Target is not a file: {target}")
    previous_hashes = {
        info["sha256"] for info in prior.values() if info["filename"].casefold() == target.name.casefold()
    }
    if not previous_hashes or sha256_file(target) not in previous_hashes:
        raise RuntimeError(
            f"Output already exists and is not an unchanged file generated by this script: {target.name}. "
            "Choose a new empty OUTPUT_ROOT to protect existing files."
        )


def style_sheet(ws, widths):
    for cell in ws[1]:
        cell.fill = PatternFill("solid", fgColor="17365D")
        cell.font = Font(bold=True, color="FFFFFF")
        cell.alignment = Alignment(horizontal="left")
    for idx, width in enumerate(widths, 1):
        ws.column_dimensions[__import__("openpyxl").utils.get_column_letter(idx)].width = width
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions


def main():
    source = Path(SOURCE_ROOT).expanduser().resolve()
    output = Path(OUTPUT_ROOT).expanduser().resolve()
    if not source.is_dir():
        raise SystemExit(f"SOURCE_ROOT does not exist or is not a folder: {source}")
    if source == output or source in output.parents or output in source.parents:
        raise SystemExit("OUTPUT_ROOT must be separate from SharePoint SOURCE_ROOT, not inside/above it.")
    output.mkdir(parents=True, exist_ok=True)

    groups: dict[str, dict[str, list[Path]]] = defaultdict(
        lambda: {"pdf": [], "msg": [], "excel": []}
    )
    for path in sorted(source.rglob("*"), key=lambda p: str(p).casefold()):
        if not path.is_file() or path.name.startswith("~$"):
            continue
        extension = path.suffix.casefold()
        if extension not in {".pdf", ".msg"} | EXCEL_SUFFIXES:
            continue
        group = group_name(path, source)
        if extension == ".pdf":
            groups[group]["pdf"].append(path)
        elif extension == ".msg":
            groups[group]["msg"].append(path)
        else:
            groups[group]["excel"].append(path)

    # Only create a PDF for a folder containing at least one PDF or MSG.
    active = {g: data for g, data in groups.items() if data["pdf"] or data["msg"]}
    names = allocate_names(active)
    previous = load_manifest(output / MANIFEST_FILE)
    produced: dict[str, dict[str, str]] = {}
    failures = []
    rows = []
    audit_rows = []
    excluded_rows = []
    font = select_font()

    print(f"Found {len(active)} folder(s) with PDFs/MSGs. "
          f"Input Excel files excluded: {sum(len(v['excel']) for v in groups.values())}.")

    # Collect skipped Excel files on an audit sheet; do not open or merge them.
    for agency, data in sorted(groups.items(), key=lambda item: item[0].casefold()):
        for path in data["excel"]:
            excluded_rows.append([agency, path.relative_to(source).as_posix()])

    for agency, data in sorted(active.items(), key=lambda item: item[0].casefold()):
        pdfs = sorted(data["pdf"], key=lambda p: str(p).casefold())
        messages = sorted(data["msg"], key=lambda p: str(p).casefold())
        target = output / names[agency]
        tmp = target.with_name(target.name + ".partial")
        dates_from_pdfs = []
        dates_from_msg = []
        page_count = 0
        try:
            # Protect earlier output or user edits before starting a write.
            safe_to_replace(target, previous)
            with fitz.open() as combined:
                # EVERY source PDF in the agency, including nested folders.
                for pdf_path in pdfs:
                    with fitz.open(str(pdf_path)) as original:
                        if original.needs_pass:
                            raise RuntimeError(f"Password protected PDF: {pdf_path}")
                        if original.page_count == 0:
                            raise RuntimeError(f"Empty PDF: {pdf_path}")
                        if original.page_count and len(dates_from_pdfs) < len(pdfs):
                            try:
                                dates_from_pdfs.append(pdf_top_date(original[0]))
                            except Exception:
                                dates_from_pdfs.append(None)
                        combined.insert_pdf(original)
                        page_count += original.page_count
                # EVERY MSG in this agency, regardless of message/file name.
                for msg_path in messages:
                    info = read_message(msg_path)
                    dates_from_msg.append(message_date(info["date"]))
                    rendered = msg_to_pdf_bytes(info, msg_path, font)
                    with fitz.open(stream=rendered, filetype="pdf") as email_pdf:
                        combined.insert_pdf(email_pdf)
                        page_count += email_pdf.page_count
                if combined.page_count == 0:
                    raise RuntimeError("Nothing to combine")
                # Write new file first; never edit the source PDF.
                combined.save(str(tmp), garbage=3, deflate=True)
            tmp.replace(target)
            digest = sha256_file(target)
            produced[agency] = {"filename": target.name, "sha256": digest}
            activity = next((d for d in dates_from_pdfs if d), None)
            source_of_date = "Source PDF (top of page 1)" if activity else ""
            if not activity:
                activity = next((d for d in dates_from_msg if d), None)
                if activity:
                    source_of_date = "MSG sent date"
            if not activity:
                source_of_date = "No readable date found"
            rows.append([target.name, activity])
            audit_rows.append([agency, target.name, len(pdfs), len(messages),
                               len(data["excel"]), page_count, source_of_date, "OK"])
            print(f"[OK] {agency}: {len(pdfs)} PDF + {len(messages)} MSG => "
                  f"{target.name} ({page_count} pages; {len(data['excel'])} Excel ignored)")
        except Exception as exc:
            failures.append([agency, target.name, str(exc)])
            audit_rows.append([agency, target.name, len(pdfs), len(messages),
                               len(data["excel"]), "", "", "FAILED"])
            print(f"[ERROR] {agency}: {exc}")
        finally:
            tmp.unlink(missing_ok=True)

    # If a folder failed this run, keep its prior manifest entry intact
    # (and hence its last export) rather than losing the only earlier result.
    for agency, details in previous.items():
        if agency not in produced and any(row[0] == agency for row in failures):
            produced[agency] = details

    # Remove *only* stale exports from previous runs of THIS script that
    # still have their original generated hashes. Never touch user-edited PDFs.
    for agency, details in previous.items():
        old_name = details["filename"]
        new = produced.get(agency)
        if new and new["filename"].casefold() == old_name.casefold():
            continue
        if any(v["filename"].casefold() == old_name.casefold() for v in produced.values()):
            continue
        old_target = output / old_name
        if old_target.is_file() and sha256_file(old_target) == details["sha256"]:
            old_target.unlink()
            print(f"[CLEANUP] Removed old script-generated output: {old_name}")

    manifest_path = output / MANIFEST_FILE
    manifest_tmp = output / (MANIFEST_FILE + ".partial")
    manifest_tmp.write_text(json.dumps({"version": 4, "groups": produced},
                                       indent=2, sort_keys=True), encoding="utf-8")
    manifest_tmp.replace(manifest_path)

    wb = Workbook()
    ws = wb.active
    ws.title = "Activity Dates"
    ws.append(["File Name", "Activity Date"])
    for filename, date in rows:
        ws.append([filename, date])
        ws.cell(ws.max_row, 2).number_format = "mm/dd/yyyy"

    audit = wb.create_sheet("Merge Audit")
    audit.append(["Agency Folder", "Output PDF", "Input PDFs", "Input MSGs",
                  "Excel Files Ignored", "Pages", "Activity Date Source", "Status"])
    for row in audit_rows:
        audit.append(row)
    skipped = wb.create_sheet("Ignored Excel Files")
    skipped.append(["Agency Folder", "Excel File Ignored"])
    for row in excluded_rows:
        skipped.append(row)
    errors_ws = wb.create_sheet("Errors")
    errors_ws.append(["Agency Folder", "Expected PDF", "Problem"])
    for row in failures:
        errors_ws.append(row)
    for sheet, widths in (
        (ws, [57, 22]), (audit, [36, 59, 16, 16, 22, 13, 35, 14]),
        (skipped, [36, 86]), (errors_ws, [36, 58, 100])
    ):
        style_sheet(sheet, widths)
    report = output / "Activity_Dates.xlsx"
    wb.save(report)

    print("\n=== FINISHED ===")
    print(f"Merged PDFs:     {len(rows)} (one per successful agency folder)")
    print(f"Failed folders:  {len(failures)}")
    print(f"Ignored Excel:   {len(excluded_rows)}")
    print(f"Flat PDF folder: {output}")
    print(f"Excel report:    {report}")
    if failures:
        print("Open the 'Errors' sheet in Activity_Dates.xlsx to review failures.")


if __name__ == "__main__":
    main()
