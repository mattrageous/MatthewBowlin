SOURCE_ROOT = r"C:\Users\YourUsername\OneDrive - Organization\SharePoint Agency Files"
OUTPUT_ROOT = r"C:\Temp\AgencyMergedPDFs_Flat"

# Fraction of first PDF page to search for the Activity Date.
TOP_PORTION = 0.45

# Set True to reproduce originals even when there is no matching MSG.
COPY_UNMATCHED_PDFS = True
