MONTH = (
    r"(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|"
    r"Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|"
    r"Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
)
DATE_PATTERN = re.compile(
    rf"(?<!\w)(?:"
    rf"\d{{4}}[./-]\d{{1,2}}[./-]\d{{1,2}}|"
    rf"\d{{1,2}}[./-]\d{{1,2}}[./-]\d{{2,4}}|"
    rf"{MONTH}\.?\s+\d{{1,2}}(?:st|nd|rd|th)?,?\s+\d{{4}}|"
    rf"\d{{1,2}}(?:st|nd|rd|th)?\s+{MONTH}\.?,?\s+\d{{4}}"
    rf")(?!\w)",
    re.I,
)

# Only explicit labeled IDs are safe for automatically linking when an agency has many PDFs.
IDENTIFIER_PATTERN = re.compile(
    r"\b(?:case|incident|complaint|matter|reference|ref|tracking|control|report|file)"
    r"\s*(?:number|no\.?|#|id)?\s*[:#-]\s*([A-Z0-9][A-Z0-9/_-]{4,})\b",
    re.I,
)


def parse_date(value: str) -> Optional[datetime]:
    value = value.strip()
    if re.fullmatch(r"\d{4}[./-]\d{1,2}[./-]\d{1,2}", value):
        y, m, d = re.split(r"[./-]", value)
        try:
            return datetime(int(y), int(m), int(d))
        except ValueError:
            return None
    if re.fullmatch(r"\d{1,2}[./-]\d{1,2}[./-]\d{2,4}", value):
        m, d, y = re.split(r"[./-]", value)
        try:
            return datetime.strptime(f"{m}/{d}/{y}", "%m/%d/%Y" if len(y) == 4 else "%m/%d/%y")
        except ValueError:
            return None

    value = re.sub(r"(?<=\d)(st|nd|rd|th)\b", "", value, flags=re.I)
    value = re.sub(r"\bSept\b", "Sep", value, flags=re.I)
    value = " ".join(re.sub(r"[.,]", " ", value).split())
    for fmt in ("%B %d %Y", "%b %d %Y", "%d %B %Y", "%d %b %Y"):
        try:
            return datetime.strptime(value, fmt)
        except ValueError:
            pass
    return None



def parse_message_date(value: str) -> Optional[datetime]:
    """Return the calendar date from an Outlook MSG header for Excel."""
    value = value.strip()
    if not value:
        return None
    try:
        parsed = parsedate_to_datetime(value)
        return datetime(parsed.year, parsed.month, parsed.day)
    except (TypeError, ValueError, IndexError, OverflowError):
        pass
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        return datetime(parsed.year, parsed.month, parsed.day)
    except ValueError:
        pass
    for match in DATE_PATTERN.finditer(value):
        date = parse_date(match.group(0))
        if date is not None:
            return date
    return None


def date_cell(ws, filename: str, activity_date: Optional[datetime]):
    ws.append([filename, activity_date])
    ws.cell(ws.max_row, 2).number_format = "mm/dd/yyyy"


def reserve_name(candidate: str, reserved: set[str]) -> str:
    """Claim a filename, case-insensitively, adding _2, _3 ... when needed."""
    original = Path(candidate)
    result = original.name
    counter = 2
    while result.casefold() in reserved:
        result = f"{original.stem}_{counter}{original.suffix}"
        counter += 1
    reserved.add(result.casefold())
    return result


def safe_agency_suffix(agency: str) -> str:
    """Clean folder labels for Windows output filenames."""
    if agency == "(root)":
        return "Root"
    cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1f]', '_', agency).strip(' .')
    return cleaned or "Agency"


def allocate_flat_pdf_names(pdfs: list[PDFRecord]) -> tuple[dict[Path, str], set[str]]:
    """Preserve original PDF names wherever possible; disambiguate collisions.

    Unique original names reserve first so collision-renamed files can never
    steal a filename that already belongs to an original source document.
    """
    from collections import Counter
    counts = Counter(item.path.name.casefold() for item in pdfs)
    assigned: dict[Path, str] = {}
    reserved: set[str] = set()
    for item in sorted(pdfs, key=lambda x: (counts[x.path.name.casefold()] > 1,
                                           str(x.path).casefold())):
        old_name = item.path.name
        if counts[old_name.casefold()] == 1:
            proposed = old_name
        else:
            proposed = f"{item.path.stem}_{safe_agency_suffix(item.agency)}{item.path.suffix}"
        assigned[item.path] = reserve_name(proposed, reserved)
    return assigned, reserved


def standalone_email_target(msg_path: Path, source: Path, output: Path,
                            reserved: set[str]) -> Path:
    """Pick one FLAT PDF filename for an unmatched email, never colliding with originals."""
    candidate = f"{msg_path.stem}.pdf"
    if candidate.casefold() in reserved:
        agency = safe_agency_suffix(agency_of(msg_path, source))
        candidate = f"{msg_path.stem}_{agency}.pdf"
    return output / reserve_name(candidate, reserved)


def top_date_and_text(pdf_file: Path) -> tuple[Optional[datetime], str]:
    with fitz.open(str(pdf_file)) as pdf:
        if pdf.needs_pass:
            raise ValueError("PDF is encrypted/password-protected")
        if not pdf.page_count:
            return None, ""
        page = pdf[0]
        clip = fitz.Rect(page.rect.x0, page.rect.y0, page.rect.x1,
                         page.rect.y0 + page.rect.height * TOP_PORTION)
        data = page.get_text("dict", clip=clip)
        lines = []
        for block in data.get("blocks", []):
            for line in block.get("lines", []):
                txt = "".join(span.get("text", "") for span in line.get("spans", []))
                lines.append((line["bbox"][1], line["bbox"][0], txt))

        activity_date = None
        for _, _, text in sorted(lines):
            for result in DATE_PATTERN.finditer(text):
                activity_date = parse_date(result.group(0))
                if activity_date is not None:
                    break
            if activity_date is not None:
                break

        # First two pages are enough to inspect explicit identifiers when matching.
        match_text = "\n".join(pdf[p].get_text() for p in range(min(2, pdf.page_count)))
        return activity_date, match_text[:100_000]


def as_text(value) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


def read_message(path: Path) -> dict[str, str]:
    msg = extract_msg.Message(str(path))
    try:
        subject = as_text(msg.subject)
        sender = as_text(msg.sender)
        recipient = as_text(msg.to)
        sent_date = as_text(msg.date)
        body = as_text(msg.body)
        if not body.strip() and getattr(msg, "htmlBody", None):
            # HTML only: fall back to a plain-text representation.
            from html.parser import HTMLParser

            class TextExtractor(HTMLParser):
                def __init__(self):
                    super().__init__()
                    self.parts = []
                def handle_data(self, data):
                    self.parts.append(data)
                def handle_starttag(self, tag, attrs):
                    if tag in {"br", "p", "div", "li", "tr"}:
                        self.parts.append("\n")
            parser = TextExtractor()
            parser.feed(as_text(msg.htmlBody))
            body = "".join(parser.parts)
        return {"subject": subject, "sender": sender, "to": recipient,
                "date": sent_date, "body": body}
    finally:
        msg.close()


def agency_of(path: Path, source: Path) -> str:
    rel = path.relative_to(source)
    return rel.parts[0] if len(rel.parts) > 1 else "(root)"


def relpath(path: Path, root: Path) -> str:
    return path.relative_to(root).as_posix()


def explicit_ids(text: str) -> set[str]:
    return {m.group(1).upper().rstrip("-_/.") for m in IDENTIFIER_PATTERN.finditer(text)}


@dataclass
class PDFRecord:
    path: Path
    agency: str
    activity_date: Optional[datetime]
    body: str
    read_error: str = ""


@dataclass
class MSGRecord:
    path: Path
    agency: str
    message: Optional[dict[str, str]]
    read_error: str = ""


def match_message(msg: MSGRecord, pdfs: list[PDFRecord], manual: dict[str, str],
                  source: Path, all_pdfs: dict[str, PDFRecord]) -> tuple[Optional[PDFRecord], str, str]:
    """Return chosen PDF, reason, and suggested filename. Never auto-match on date alone."""
    msg_rel = relpath(msg.path, source)
    if msg_rel.casefold() in manual:
        requested = manual[msg_rel.casefold()]
        selected = all_pdfs.get(requested.casefold())
        if not selected:
            return None, f"Manual mapping points to missing/unreadable PDF: {requested}", requested
        return selected, "Manual mapping (explicit)", ""

    if not pdfs:
        return None, "No PDF in this agency", ""
    if len(pdfs) == 1:
        return pdfs[0], "Only PDF in agency", ""

    if not msg.message:
        return None, "Message could not be read", ""

    message_text = msg.message["subject"] + "\n" + msg.message["body"]
    ids = explicit_ids(message_text)
    strong = []
    for pdf in pdfs:
        pdf_ids = explicit_ids(pdf.body)
        shared = ids & pdf_ids
        if shared:
            strong.append((pdf, "Matching labeled reference: " + ", ".join(sorted(shared)[:3])))

    if len(strong) == 1:
        return strong[0][0], strong[0][1], ""
    if len(strong) > 1:
        return None, "Same reference appears in multiple PDFs", "; ".join(p.path.name for p, _ in strong)

    # If an email directly mentions a sufficiently distinctive PDF name,
    # that is a strong indicator, provided just one PDF qualifies.
    mentions = []
    normalized_msg = re.sub(r"[^a-z0-9]+", "", message_text.casefold())
    for pdf in pdfs:
        stem_key = re.sub(r"[^a-z0-9]+", "", pdf.path.stem.casefold())
        # Avoid matching generic filename stems such as "Report" or "Invoice".
        if len(stem_key) >= 12 and stem_key in normalized_msg:
            mentions.append(pdf)
    if len(mentions) == 1:
        return mentions[0], "Distinctive PDF filename mentioned in email", ""
    if len(mentions) > 1:
        return None, "Email mentions multiple PDF filenames", "; ".join(p.path.name for p in mentions)
    return None, "Multiple PDFs; no reliable link found", ""


def select_font() -> str:
    for font_path in (
        Path(r"C:\Windows\Fonts\arial.ttf"),
        Path(r"C:\Windows\Fonts\segoeui.ttf"),
        Path("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"),
    ):
        if font_path.is_file():
            pdfmetrics.registerFont(TTFont("EmailFont", str(font_path)))
            return "EmailFont"
    return "Helvetica"


def message_to_pdf(message: dict[str, str], original: Path, font_name: str) -> bytes:
    from io import BytesIO
    stream = BytesIO()
    doc = SimpleDocTemplate(stream, pagesize=letter, leftMargin=42, rightMargin=42,
                            topMargin=46, bottomMargin=46, title=original.name)
    header_style = ParagraphStyle("EmailHeading", fontName=font_name, fontSize=12,
                                  leading=16, spaceAfter=10, textColor=colors.HexColor("#17365D"))
    label_style = ParagraphStyle("EmailHeader", fontName=font_name, fontSize=9,
                                 leading=13, spaceAfter=4, splitLongWords=1)
    body_style = ParagraphStyle("EmailBody", fontName=font_name, fontSize=9,
                                leading=13, spaceAfter=2, alignment=TA_LEFT,
                                splitLongWords=1)
    story = [Paragraph("Email: " + escape(original.name), header_style)]
    for title, key in (("Subject", "subject"), ("From", "sender"),
                       ("To", "to"), ("Date", "date")):
        val = message.get(key, "").strip() or "(not provided)"
        story.append(Paragraph(f"<b>{title}:</b> {escape(val)}", label_style))
    story.extend([Spacer(1, 7), HRFlowable(width="100%", thickness=0.5,
                                           color=colors.grey), Spacer(1, 9)])
    body = message.get("body", "") or "(No readable email body)"
    # Make each line a splittable paragraph so multi-page emails are supported.
    for line in body.splitlines():
        if not line.strip():
            story.append(Spacer(1, 6))
        else:
            story.append(Paragraph(escape(line).replace("\t", "&nbsp; " ), body_style))
    doc.build(story)
    return stream.getvalue()


def read_standalone_manifest(manifest_path: Path) -> dict[str, str]:
    if not manifest_path.exists():
        return {}
    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            return {k: v for k, v in data.items()
                    if isinstance(k, str) and isinstance(v, str)}
    except (OSError, ValueError):
        pass
    return {}


def update_standalone_manifest(output: Path, previous: dict[str, str],
                               current: dict[str, str]) -> int:
    """Delete only former exports whose bytes still match what we last generated."""
    removed = 0
    for rel, old_digest in previous.items():
        if rel in current:
            continue
        old_path = Path(rel)
        if old_path.is_absolute() or ".." in old_path.parts:
            continue
        candidate = output / old_path
        if not candidate.is_file():
            continue
        try:
            digest = hashlib.sha256(candidate.read_bytes()).hexdigest()
            if digest == old_digest:
                candidate.unlink()
                removed += 1
                print(f"[CLEANUP] Removed previously exported standalone email: {rel}")
        except OSError:
            continue
    path = output / "standalone_msg_manifest.json"
    temp = path.with_suffix(".json.partial")
    try:
        temp.write_text(json.dumps(current, indent=2, sort_keys=True), encoding="utf-8")
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)
    return removed


def load_manual_matches(file_path: Path, source: Path) -> dict[str, str]:
    if not file_path.exists():
        file_path.parent.mkdir(parents=True, exist_ok=True)
        with file_path.open("w", encoding="utf-8-sig", newline="") as file:
            csv.writer(file).writerow(["MSG File", "PDF File"])
        return {}

    mappings = {}
    with file_path.open("r", encoding="utf-8-sig", newline="") as file:
        for item in csv.DictReader(file):
            msg_path = (item.get("MSG File") or "").strip().replace("\\", "/")
            pdf_path = (item.get("PDF File") or "").strip().replace("\\", "/")
            if not msg_path or not pdf_path:
                continue
            # Require relative paths to ensure there are no cross-directory surprises.
            for path_text in (msg_path, pdf_path):
                parts = Path(path_text).parts
                if Path(path_text).is_absolute() or ".." in parts or ":" in path_text:
                    raise ValueError(f"Manual match path must be relative to SOURCE_ROOT: {path_text}")
            mappings[msg_path.casefold()] = pdf_path
    return mappings


def style_sheet(ws, widths: list[int]):
    fill = PatternFill("solid", fgColor="17365D")
    for cell in ws[1]:
        cell.fill = fill
        cell.font = Font(bold=True, color="FFFFFF")
        cell.alignment = Alignment(horizontal="left")
    for idx, width in enumerate(widths, 1):
        ws.column_dimensions[__import__("openpyxl").utils.get_column_letter(idx)].width = width
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions


def main():
    source = Path(SOURCE_ROOT).expanduser().resolve()
    output = Path(OUTPUT_ROOT).expanduser().resolve()
    if not source.is_dir():
        raise SystemExit(f"Source folder does not exist: {source}")
    if source == output or source in output.parents or output in source.parents:
        raise SystemExit("For safety, OUTPUT_ROOT must be separate from SOURCE_ROOT (not inside it or above it).")
    output.mkdir(parents=True, exist_ok=True)
    mapping_file = output / "manual_matches.csv"
    mappings = load_manual_matches(mapping_file, source)
    previous_standalones = read_standalone_manifest(output / "standalone_msg_manifest.json")
    font = select_font()

    pdf_paths = sorted((p for p in source.rglob("*") if p.is_file() and p.suffix.lower() == ".pdf"),
                       key=lambda p: str(p).casefold())
    msg_paths = sorted((p for p in source.rglob("*") if p.is_file() and p.suffix.lower() == ".msg"),
                       key=lambda p: str(p).casefold())
    print(f"Found {len(pdf_paths)} PDF(s), {len(msg_paths)} MSG(s).")

    pdfs = []
    errors = []
    for path in pdf_paths:
        try:
            date, text = top_date_and_text(path)
            pdfs.append(PDFRecord(path, agency_of(path, source), date, text))
        except Exception as exc:
            pdfs.append(PDFRecord(path, agency_of(path, source), None, "", str(exc)))
            errors.append(("PDF", relpath(path, source), str(exc)))

    messages = []
    for path in msg_paths:
        try:
            messages.append(MSGRecord(path, agency_of(path, source), read_message(path)))
        except Exception as exc:
            messages.append(MSGRecord(path, agency_of(path, source), None, str(exc)))
            errors.append(("MSG", relpath(path, source), str(exc)))

    pdfs_by_agency = defaultdict(list)
    valid_pdfs = {}
    for item in pdfs:
        if not item.read_error:
            pdfs_by_agency[item.agency].append(item)
            valid_pdfs[relpath(item.path, source).casefold()] = item

    assignments = defaultdict(list)
    match_rows = []
    review_rows = []
    unmatched_messages = []
    for msg in messages:
        msg_rel = relpath(msg.path, source)
        if msg.read_error:
            review_rows.append((msg.agency, msg_rel, "Unreadable MSG", ""))
            continue
        pdf, reason, suggestion = match_message(
            msg, pdfs_by_agency[msg.agency], mappings, source, valid_pdfs
        )
        if pdf:
            assignments[pdf.path].append(msg)
            match_rows.append((msg.agency, msg_rel, relpath(pdf.path, source), reason))
        else:
            # Keep an audit trail even though this email will also be exported to PDF.
            review_rows.append((msg.agency, msg_rel, reason, suggestion))
            unmatched_messages.append((msg, reason))

    wb = Workbook()
    ws = wb.active
    ws.title = "Activity Dates"
    ws.append(["File Name", "Activity Date"])
    audit = wb.create_sheet("Merge Audit")
    audit.append(["Agency", "PDF File", "Merged MSG Count", "Output PDF", "Activity Date Status"])
    matched = wb.create_sheet("Matched Emails")
    matched.append(["Agency", "MSG File", "PDF File", "Reason"])
    standalone = wb.create_sheet("Standalone Emails")
    standalone.append(["Agency", "MSG File", "Output PDF", "Activity Date", "Reason"])
    needs = wb.create_sheet("Needs Review")
    needs.append(["Agency", "MSG File", "Reason", "Possible PDF(s)", "Standalone PDF"])
    problem = wb.create_sheet("Errors")
    problem.append(["File Type", "File", "Error"])

    flat_pdf_names, reserved_names = allocate_flat_pdf_names(pdfs)
    merged = copied = failed = 0
    for pdf in pdfs:
        target = output / flat_pdf_names[pdf.path]
        status = "Found" if pdf.activity_date is not None else "Not found (possibly scanned)"
        if pdf.read_error:
            audit.append([pdf.agency, relpath(pdf.path, source), 0, "", "PDF could not be read"])
            continue
        emails = assignments[pdf.path]
        if not emails and not COPY_UNMATCHED_PDFS:
            audit.append([pdf.agency, relpath(pdf.path, source), 0, "Not copied", status])
            continue
        # Write a separate output PDF so no SharePoint source is touched.
        try:
            with fitz.open(str(pdf.path)) as result:
                for email in emails:
                    email_bytes = message_to_pdf(email.message, email.path, font)
                    with fitz.open(stream=email_bytes, filetype="pdf") as email_pdf:
                        result.insert_pdf(email_pdf)
                temp_target = target.with_name(target.name + ".partial")
                try:
                    result.save(str(temp_target), garbage=3, deflate=True)
                    temp_target.replace(target)
                finally:
                    temp_target.unlink(missing_ok=True)
            if emails:
                merged += 1
            else:
                copied += 1
            date_cell(ws, target.name, pdf.activity_date)
            audit.append([pdf.agency, relpath(pdf.path, source), len(emails),
                          relpath(target, output), status])
            print(f"[OK] {relpath(target, output)}  ({len(emails)} email(s))")
        except Exception as exc:
            failed += 1
            errors.append(("MERGE", relpath(pdf.path, source), str(exc)))
            audit.append([pdf.agency, relpath(pdf.path, source), len(emails), "FAILED", status])
            print(f"[ERROR] {relpath(pdf.path, source)}: {exc}")

    # Every readable MSG that could not be confidently matched becomes a
    # standalone PDF. It remains in Needs Review for optional future mapping.
    standalone_count = 0
    new_standalones = {}
    review_exports = {}
    for msg, reason in unmatched_messages:
        target = standalone_email_target(msg.path, source, output, reserved_names)
        try:
            email_bytes = message_to_pdf(msg.message, msg.path, font)
            temp_target = target.with_name(target.name + ".partial")
            try:
                temp_target.write_bytes(email_bytes)
                temp_target.replace(target)
            finally:
                temp_target.unlink(missing_ok=True)
            new_standalones[relpath(target, output)] = hashlib.sha256(email_bytes).hexdigest()
            review_exports[relpath(msg.path, source)] = relpath(target, output)
            email_date = parse_message_date(msg.message.get("date", ""))
            date_cell(ws, target.name, email_date)
            standalone.append([
                msg.agency, relpath(msg.path, source), relpath(target, output),
                email_date, reason,
            ])
            standalone.cell(standalone.max_row, 4).number_format = "mm/dd/yyyy"
            standalone_count += 1
            print(f"[STANDALONE MSG] {relpath(target, output)}")
        except Exception as exc:
            failed += 1
            errors.append(("MSG-TO-PDF", relpath(msg.path, source), str(exc)))
            print(f"[ERROR MSG] {relpath(msg.path, source)}: {exc}")

    for row in match_rows:
        matched.append(list(row))
    for row in review_rows:
        needs.append(list(row) + [review_exports.get(row[1], "")])
    for row in errors:
        problem.append(list(row))
    for sheet, sizes in ((ws, [60, 20]), (audit, [28, 74, 21, 76, 30]),
                         (matched, [28, 78, 78, 54]),
                         (standalone, [28, 78, 78, 20, 54]),
                         (needs, [28, 78, 58, 70, 78]),
                         (problem, [18, 78, 85])):
        style_sheet(sheet, sizes)

    report = output / "Activity_Dates.xlsx"
    wb.save(report)
    # Do not delete prior standalone exports if this run encountered conversion
    # failures: preserving an old file is safer than discarding the only copy.
    stale_removed = 0
    if not any(kind == "MSG-TO-PDF" for kind, _, _ in errors):
        stale_removed = update_standalone_manifest(output, previous_standalones, new_standalones)
    else:
        print("[NOTICE] Standalone cleanup skipped due to MSG conversion errors.")
    print("\n=== COMPLETE ===")
    print(f"PDFs with MSGs merged: {merged}")
    print(f"PDFs copied alone:      {copied}")
    print(f"Standalone MSG PDFs:    {standalone_count}")
    print(f"Old standalone removed: {stale_removed}")
    print(f"PDF merge failures:     {failed}")
